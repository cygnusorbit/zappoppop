# =====================================================================================================
# Pre-flight: every anchor must match exactly once before anything is written
# =====================================================================================================
def rd(p):
    with open(p, 'r', encoding='utf-8') as f:
        return f.read()

p1 = os.path.join(PRO, 'includes/modules/class-zappoppop-woo-cart.php')
if not os.path.isfile(p1) or 'ZPP_WC_P3' not in rd(p1):
    sys.exit('ABORT: Phase 3 is not installed yet. Run the Phase 1, 2 and 3 patches first.')

plan, problems = [], []
newplan = []
for root, rel, marker, content in NEW:
    p = os.path.join(ROOTS[root], rel)
    if os.path.isfile(p):
        if marker in rd(p):
            print('ALREADY    ' + rel)
        else:
            problems.append('exists without marker %s: %s/%s' % (marker, root, rel))
    else:
        newplan.append((root, rel, p, content))
for root, rel, marker, pairs in FILES:
    p = os.path.join(ROOTS[root], rel)
    if not os.path.isfile(p):
        problems.append('missing file: %s/%s' % (root, rel))
        continue
    txt = rd(p)
    if marker in txt:
        print('ALREADY    ' + rel)
        continue
    for old, new in pairs:
        n = txt.count(old)
        if n != 1:
            problems.append('%s/%s: anchor found %d times (expected 1): %s' % (root, rel, n, old.strip().split('\n')[0][:80]))
    plan.append((root, rel, p, txt, pairs))

if problems:
    sys.exit('ABORT, nothing written:\n  ' + '\n  '.join(problems))

# =====================================================================================================
# Apply (backups go to core's existing .patch-backups)
# =====================================================================================================
if not os.path.isdir(BK):
    os.makedirs(BK)
written = []
for root, rel, p, content in newplan:
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, 'w', encoding='utf-8') as f:
        f.write(content)
    written.append(p)
    print('CREATED     %s/%s' % (root, rel))
for root, rel, p, txt, pairs in plan:
    shutil.copy2(p, os.path.join(BK, root + '__' + rel.replace('/', '__') + '.bak-woocart4'))
    for old, new in pairs:
        txt = txt.replace(old, new, 1)
    with open(p, 'w', encoding='utf-8') as f:
        f.write(txt)
    written.append(p)
    print('PATCHED     %s/%s  (%d edit%s)' % (root, rel, len(pairs), '' if len(pairs) == 1 else 's'))

def tool(name):
    return shutil.which(name)

bad = 0
for p in written:
    if p.endswith('.js') and tool('node'):
        r = subprocess.run(['node', '--check', p], capture_output=True, text=True)
        if r.returncode:
            bad += 1
            print('JS SYNTAX ERROR ' + p + '\n' + r.stderr)
    elif p.endswith('.php') and tool('php'):
        r = subprocess.run(['php', '-l', p], capture_output=True, text=True)
        if r.returncode:
            bad += 1
            print('PHP SYNTAX ERROR ' + p + '\n' + r.stdout + r.stderr)
print('\nDone. %d file(s) patched, %d syntax problem(s). Nothing was committed.' % (len(written), bad))
if not tool('php'):
    print('Note: php is not on PATH, so PHP was not linted. Run php -l on the Pro files this patch changed (class-zappoppop-woo-cart.php, class-zappoppop-woo-recover.php, class-pro-uninstall.php, class-pro-multisite.php) && ')
