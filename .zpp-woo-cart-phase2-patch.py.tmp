    var TOKEN_RE = /\{(cart_total|cart_subtotal|cart_count|shipping_remaining|free_shipping_min|coupon_code|coupon_countdown|coupon_expires)\}/g;'''),

(r'''        r.a = r.a ? 1 : 0;
''', r'''        r.a = r.a ? 1 : 0;
