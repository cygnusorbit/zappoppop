import os, sys, shutil, subprocess

CORE = os.getcwd()
PRO = os.path.normpath(os.path.join(CORE, '..', 'zappoppop-pro'))
BK = os.path.join(CORE, '.patch-backups')
ROOTS = {'core': CORE, 'pro': PRO}

if not os.path.isfile(os.path.join(CORE, 'zappoppop.php')) or not os.path.isfile(os.path.join(PRO, 'zappoppop-pro.php')):
    sys.exit('ABORT: run from ~/Desktop/zappoppop with ../zappoppop-pro next to it.')

