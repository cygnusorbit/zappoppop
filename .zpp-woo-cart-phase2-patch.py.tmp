(r'''    var TOKEN_TEST = /\{(?:cart_total|cart_subtotal|cart_count|shipping_remaining|free_shipping_min|coupon_code)\}/;
    var TOKEN_RE = /\{(cart_total|cart_subtotal|cart_count|shipping_remaining|free_shipping_min|coupon_code)\}/g;''',
