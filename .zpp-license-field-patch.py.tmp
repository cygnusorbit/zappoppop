import re, sys
P = '../zappoppop-pro/'

def patch(path, pairs):
    s = open(P + path, encoding='utf-8').read()
    for old, new in pairs:
        if s.count(old) != 1:
            sys.exit('ABORT: anchor not found exactly once in %s:\n%s' % (path, old[:90]))
        s = s.replace(old, new)
    open(P + path, 'w', encoding='utf-8').write(s)
    print('patched', path)

# ---------------------------------------------------------------- class-pro-edd.php
old_url = """    public static function store_url() {
        $url = defined('ZAPPOPPOP_PRO_EDD_URL') ? esc_url_raw(trim((string) ZAPPOPPOP_PRO_EDD_URL)) : '';
        if ($url === '') {"""
new_url = """    const STORE_OPTION = 'zappoppop_pro_edd_store';

    /** True when wp-config.php defines the value. A constant always wins over the saved one. */
    public static function url_locked() {
        return defined('ZAPPOPPOP_PRO_EDD_URL') && trim((string) ZAPPOPPOP_PRO_EDD_URL) !== '';
    }

    public static function id_locked() {
        return defined('ZAPPOPPOP_PRO_EDD_ITEM_ID') && (int) ZAPPOPPOP_PRO_EDD_ITEM_ID > 0;
    }

    /** Store details typed into the licence screen (used only when wp-config.php does not define them). */
    public static function saved_store() {
        $s = get_site_option(self::STORE_OPTION, array());
        return wp_parse_args(is_array($s) ? $s : array(), array('url' => '', 'item_id' => 0));
    }

    /** Returns a clean https URL (http only on a local environment) or an empty string. */
    public static function valid_store_url($url) {
        $url = esc_url_raw(trim((string) $url));
        if ($url === '') {
            return '';
        }
        $local = function_exists('wp_get_environment_type') && wp_get_environment_type() === 'local';
        if (wp_parse_url($url, PHP_URL_SCHEME) !== 'https' && !$local) {
            return '';
        }
        return $url;
    }

    public static function save_store($url, $item_id) {
        $s = self::saved_store();
        if (!self::url_locked()) {
            $s['url'] = self::valid_store_url($url);
        }
        if (!self::id_locked()) {
            $s['item_id'] = max(0, (int) $item_id);
        }
        update_site_option(self::STORE_OPTION, $s);
    }

    public static function store_url() {
        if (self::url_locked()) {
            $url = esc_url_raw(trim((string) ZAPPOPPOP_PRO_EDD_URL));
        } else {
            $saved = self::saved_store();
            $url   = (string) $saved['url'];
        }
        if ($url === '') {"""

old_id = """        return defined('ZAPPOPPOP_PRO_EDD_ITEM_ID') ? max(0, (int) ZAPPOPPOP_PRO_EDD_ITEM_ID) : 0;"""
new_id = """        if (self::id_locked()) {
            return (int) ZAPPOPPOP_PRO_EDD_ITEM_ID;
        }
        $saved = self::saved_store();
        return max(0, (int) $saved['item_id']);"""

old_msg = "Licensing is not set up yet. Add the store URL and product ID to wp-config.php."
new_msg = "Licensing is not set up yet. Enter the store URL and product ID first."

old_post = """        if ($do === 'activate') {
            self::activate($key !== '' ? $key : self::get_key());"""
new_post = """        $bad_store = false;
        if ($do === 'activate' && (isset($_POST['zpp_store_url']) || isset($_POST['zpp_item_id']))) {
            $store_url = isset($_POST['zpp_store_url']) ? sanitize_text_field(wp_unslash($_POST['zpp_store_url'])) : '';
            $store_id  = isset($_POST['zpp_item_id']) ? absint(wp_unslash($_POST['zpp_item_id'])) : 0;
            if (!self::url_locked() && trim($store_url) !== '' && self::valid_store_url($store_url) === '') {
                $bad_store = true;
                self::finish(self::data(), false, __('The store URL must start with https://', 'zappoppop-pro'));
            } else {
                self::save_store($store_url, $store_id);
            }
        }
        if ($bad_store) {
            /* Message already stored; nothing else to do. */
        } elseif ($do === 'activate') {
            self::activate($key !== '' ? $key : self::get_key());"""

patch('includes/class-pro-edd.php', [(old_url, new_url), (old_id, new_id), (old_msg, new_msg), (old_post, new_post)])

