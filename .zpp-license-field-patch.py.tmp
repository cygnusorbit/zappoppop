    css = css.rstrip('\n') + "\n.zpp-lic-input + .zpp-lic-label, .zpp-lic-help + .zpp-lic-label { margin-top: 16px; }\n.zpp-lic-card details.zpp-lic-help { margin-top: 16px; padding-top: 12px; border-top: var(--zpp-bw, 1px) solid var(--zpp-c-row-border, #eee); }\n.zpp-lic-card details.zpp-lic-help summary { cursor: pointer; }\n"
    open(P + 'assets/css/license.css', 'w', encoding='utf-8').write(css)
