(r"""    /* Keeps {coupon_countdown} ticking while a popup is open. */""", r"""    /* ZPP_WC_P6: asks the server for this visitor's own coupon, then shows the popup (or keeps it hidden when the offer is over). */
    function issueEv(uid) {
        if (evBusy[uid]) { return; }
        evBusy[uid] = 1;
        var done = function (ok) { $(document).trigger('zappoppop:wc_released', [uid, ok]); };
        if (!W.evUrl) { delete evBusy[uid]; done(false); return; }
        $.ajax({ url: W.evUrl, type: 'POST', dataType: 'json', cache: false, timeout: 8000, data: { uid: uid } })
            .done(function (res) {
                var d = (res && res.success) ? res.data : null, $w, r, c, ok = false;
                if (d && d.code) {
                    ev[uid] = { code: String(d.code), x: +d.x || 0 };
                    if (+d.now) { skew = (+d.now * 1000) - new Date().getTime(); }
                    ok = true;
                } else if (d && d.ended) {
                    ev[uid] = { ended: 1 };
                }
                if (ok) {
                    $w = wrap(uid);
                    r = parse($w);
                    c = (cart && !cart.failed) ? cart : ZERO;
                    if (r) { render($w, c, r); maybeApply(uid, r, c); }
                    startTick();
                    origShow.call(D, uid);
                }
                done(ok);
            })
            .fail(function () { done(false); })
            .always(function () { delete evBusy[uid]; });
    }
    /* Keeps {coupon_countdown} ticking while a popup is open. */"""),

