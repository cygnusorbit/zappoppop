import os, sys, shutil, subprocess

CORE = os.getcwd()
PRO = os.path.normpath(os.path.join(CORE, '..', 'zappoppop-pro'))
BK = os.path.join(CORE, '.patch-backups')
ROOTS = {'core': CORE, 'pro': PRO}

if not os.path.isfile(os.path.join(CORE, 'zappoppop.php')) or not os.path.isfile(os.path.join(PRO, 'zappoppop-pro.php')):
    sys.exit('ABORT: run from ~/Desktop/zappoppop with ../zappoppop-pro next to it.')

FILES = []   # (root, rel, marker, [(old, new), ...])

NEW = []     # (root, rel, marker, content)
NEW.append(('pro', 'includes/modules/class-zappoppop-woo-evergreen.php', 'ZPP_WC_P6', '<?php\n/**\n * ZapPopPop Pro: WooCommerce evergreen (per-visitor) coupons.   ZPP_WC_P6\n *\n * The popup\'s coupon code is a TEMPLATE. Each visitor who is about to see the popup gets their own single-use copy\n * of it that expires N minutes after they first see the offer, so the countdown is real and a shared code cannot spread.\n *  - The browser sends only the popup uid; the template code is never printed in the page.\n *  - The visitor\'s coupon is remembered in a signed cookie: the offer is one-time per visitor.\n *  - Per-IP and per-popup limits stop a script from filling the shop with coupons.\n *  - A daily cleanup removes expired, unused copies.\n * Keep the template coupon as a Draft: it then cannot be used directly at checkout, but is still copied.\n *\n * @package ZapPopPop_Pro\n */\n\nif (!defined(\'ABSPATH\')) {\n    exit;\n}\n\nclass ZapPopPop_Woo_Evergreen {\n\n    const ENDPOINT = \'zappoppop_wc_evergreen\';\n    const CRON     = \'zappoppop_wc_ev_cleanup\';\n    const META     = \'_zpp_ev_uid\';\n    const PER_IP   = 3;       /* new coupons per visitor address, popup and day */\n    const PER_HOUR = 300;     /* new coupons per popup and hour */\n    const COOKIE_T = 2592000; /* 30 days */\n\n    public static function boot() {\n        add_action(\'wc_ajax_\' . self::ENDPOINT, array(__CLASS__, \'ajax\'));\n        add_action(self::CRON, array(__CLASS__, \'cleanup\'));\n        add_action(\'init\', array(__CLASS__, \'schedule\'));\n    }\n\n    public static function schedule() {\n        if (!wp_next_scheduled(self::CRON)) {\n            wp_schedule_event(time() + 3600, \'daily\', self::CRON);\n        }\n    }\n\n    /* ---------------------------------------------------------------- settings */\n\n    public static function defaults() {\n        return array(\'ev_on\' => false, \'ev_minutes\' => 30);\n    }\n\n    public static function sanitize($in) {\n        $in = is_array($in) ? $in : array();\n        $on = isset($in[\'ev_on\']) && in_array($in[\'ev_on\'], array(true, 1, \'1\', \'true\', \'on\'), true);\n        $m  = isset($in[\'ev_minutes\']) ? $in[\'ev_minutes\'] : 30;\n        $m  = (is_scalar($m) && is_numeric($m)) ? max(5, min(1440, (int) round((float) $m))) : 30;\n        return array(\'ev_on\' => $on, \'ev_minutes\' => $m);\n    }\n\n    /** True when this popup config hands out per-visitor coupons (needs a template code). */\n    public static function enabled($c) {\n        return is_array($c) && !empty($c[\'ev_on\']) && isset($c[\'coupon_code\']) && $c[\'coupon_code\'] !== \'\';\n    }\n\n    /* ---------------------------------------------------------------- cookie */\n\n    protected static function cookie_name($uid) {\n        return \'zpp_ev_\' . substr(md5((string) $uid), 0, 10);\n    }\n\n    protected static function sign($code, $uid) {\n        return substr(hash_hmac(\'sha256\', $code . \'|\' . $uid, wp_salt(\'auth\')), 0, 20);\n    }\n\n    /** The coupon code stored for this visitor and popup, or \'\' (missing or tampered cookie). */\n    protected static function read_cookie($uid) {\n        $n = self::cookie_name($uid);\n        if (empty($_COOKIE[$n]) || !is_string($_COOKIE[$n])) {\n            return \'\';\n        }\n        $v = explode(\'.\', sanitize_text_field(wp_unslash($_COOKIE[$n])));\n        if (count($v) !== 2 || $v[0] === \'\' || !hash_equals(self::sign($v[0], $uid), (string) $v[1])) {\n            return \'\';\n        }\n        return $v[0];\n    }\n\n    protected static function write_cookie($uid, $code) {\n        if (headers_sent()) {\n            return;\n        }\n        $exp  = time() + self::COOKIE_T;\n        $path = defined(\'COOKIEPATH\') && COOKIEPATH ? COOKIEPATH : \'/\';\n        $val  = $code . \'.\' . self::sign($code, $uid);\n        if (PHP_VERSION_ID >= 70300) {\n            setcookie(self::cookie_name($uid), $val, array(\'expires\' => $exp, \'path\' => $path, \'secure\' => is_ssl(), \'httponly\' => true, \'samesite\' => \'Lax\'));\n        } else {\n            setcookie(self::cookie_name($uid), $val, $exp, $path . \'; samesite=Lax\', \'\', is_ssl(), true);\n        }\n        $_COOKIE[self::cookie_name($uid)] = $val;\n    }\n\n    /* ---------------------------------------------------------------- coupons */\n\n    /** WooCommerce coupon id by code, drafts and private ones included (the template may be a Draft). */\n    protected static function template_id($code) {\n        global $wpdb;\n        $code = wc_format_coupon_code($code);\n        if ($code === \'\') {\n            return 0;\n        }\n        // phpcs:ignore WordPress.DB.DirectDatabaseQuery -- no core API finds draft coupons by code.\n        return (int) $wpdb->get_var($wpdb->prepare("SELECT ID FROM {$wpdb->posts} WHERE post_type = \'shop_coupon\' AND post_status IN (\'publish\',\'draft\',\'private\') AND post_title = %s ORDER BY ID DESC LIMIT 1", $code));\n    }\n\n    /** A visitor copy: its WC_Coupon when it is ours for this popup, else null. */\n    protected static function own($code, $uid) {\n        $id = function_exists(\'wc_get_coupon_id_by_code\') ? (int) wc_get_coupon_id_by_code($code) : 0;\n        if ($id < 1) {\n            return null;\n        }\n        try {\n            $cp = new WC_Coupon($id);\n        } catch (Throwable $e) {\n            return null;\n        }\n        return ((string) $cp->get_meta(self::META) === (string) $uid) ? $cp : null;\n    }\n\n    protected static function expiry($cp) {\n        $d = $cp->get_date_expires();\n        return $d ? (int) $d->getTimestamp() : 0;\n    }\n\n    /** \'ok\' while the visitor\'s copy can still be used. */\n    protected static function status($cp) {\n        $x = self::expiry($cp);\n        if ($x > 0 && $x <= time()) {\n            return \'expired\';\n        }\n        return ((int) $cp->get_usage_count() > 0) ? \'used\' : \'ok\';\n    }\n\n    /** The code the apply endpoint may apply for this visitor (\'\' = none valid). */\n    public static function code_for($uid, $c) {\n        if (!self::enabled($c)) {\n            return \'\';\n        }\n        $code = self::read_cookie($uid);\n        if ($code === \'\') {\n            return \'\';\n        }\n        $cp = self::own($code, $uid);\n        return ($cp && self::status($cp) === \'ok\') ? $code : \'\';\n    }\n\n    protected static function limited($uid) {\n        $ip = isset($_SERVER[\'REMOTE_ADDR\']) ? sanitize_text_field(wp_unslash($_SERVER[\'REMOTE_ADDR\'])) : \'\';\n        $k1 = \'zpp_ev_ip_\' . md5($uid . \'|\' . $ip . \'|\' . wp_salt(\'auth\'));\n        $k2 = \'zpp_ev_h_\' . md5($uid);\n        return array((int) get_transient($k1) >= self::PER_IP || (int) get_transient($k2) >= self::PER_HOUR, $k1, $k2);\n    }\n\n    protected static function make($uid, $c) {\n        $tid = self::template_id($c[\'coupon_code\']);\n        if ($tid < 1) {\n            return null;\n        }\n        try {\n            $tpl = new WC_Coupon($tid);\n            $now = time();\n            $end = $now + ((int) $c[\'ev_minutes\'] * 60);\n            $tx  = self::expiry($tpl);\n            if ($tx > 0) {\n                $end = min($end, $tx);\n            }\n            if ($end <= $now + 60) {\n                return null; /* the template itself is (almost) expired */\n            }\n            $cp   = null;\n            $code = \'\';\n            for ($i = 0; $i < 4; $i++) {\n                $code = \'ZPP-\' . strtoupper(bin2hex(random_bytes(4)));\n                if ((int) wc_get_coupon_id_by_code($code) < 1) {\n                    $cp = new WC_Coupon();\n                    break;\n                }\n            }\n            if (!$cp) {\n                return null;\n            }\n            $cp->set_code($code);\n            $cp->set_discount_type($tpl->get_discount_type());\n            $cp->set_amount($tpl->get_amount());\n            $cp->set_free_shipping($tpl->get_free_shipping());\n            $cp->set_individual_use($tpl->get_individual_use());\n            $cp->set_exclude_sale_items($tpl->get_exclude_sale_items());\n            $cp->set_product_ids($tpl->get_product_ids());\n            $cp->set_excluded_product_ids($tpl->get_excluded_product_ids());\n            $cp->set_product_categories($tpl->get_product_categories());\n            $cp->set_excluded_product_categories($tpl->get_excluded_product_categories());\n            $cp->set_minimum_amount($tpl->get_minimum_amount());\n            $cp->set_maximum_amount($tpl->get_maximum_amount());\n            $cp->set_usage_limit(1);\n            $cp->set_usage_limit_per_user(1);\n            $cp->set_date_expires($end);\n            $cp->set_description(\'ZapPopPop evergreen coupon (auto-created)\');\n            $cp->update_meta_data(self::META, (string) $uid);\n            if (!$cp->save()) {\n                return null;\n            }\n            return array(\'code\' => $code, \'x\' => $end);\n        } catch (Throwable $e) {\n            return null;\n        }\n    }\n\n    /* ---------------------------------------------------------------- endpoint */\n\n    /** POST uid. Answers {code,x} (the visitor\'s own coupon), {ended:true} (already used or expired) or an error. */\n    public static function ajax() {\n        nocache_headers();\n        // phpcs:ignore WordPress.Security.NonceVerification.Missing -- hands out a server-configured coupon, rate limited; no state of the caller is changed.\n        $uid = isset($_POST[\'uid\']) ? sanitize_text_field(wp_unslash($_POST[\'uid\'])) : \'\';\n        if ($uid === \'\' || !class_exists(\'ZapPopPop_Woo_Cart\') || !ZapPopPop_Woo_Cart::module_active() || !ZapPopPop_Woo_Cart::woo_active() || !class_exists(\'ZapPopPop_Module_Bridge\')) {\n            wp_send_json_error(array(\'message\' => \'inactive\'));\n        }\n        $c = ZapPopPop_Woo_Cart::active(ZapPopPop_Module_Bridge::stored_settings($uid));\n        if (!self::enabled($c)) {\n            wp_send_json_error(array(\'message\' => \'inactive\'));\n        }\n        $have = self::read_cookie($uid);\n        if ($have !== \'\') {\n            $cp = self::own($have, $uid);\n            if ($cp && self::status($cp) === \'ok\') {\n                wp_send_json_success(array(\'code\' => $have, \'x\' => self::expiry($cp), \'now\' => time()));\n            }\n            wp_send_json_success(array(\'ended\' => true)); /* one offer per visitor */\n        }\n        $lim = self::limited($uid);\n        if ($lim[0]) {\n            wp_send_json_error(array(\'message\' => \'limit\'));\n        }\n        $new = self::make($uid, $c);\n        if (!$new) {\n            wp_send_json_error(array(\'message\' => \'inactive\'));\n        }\n        set_transient($lim[1], (int) get_transient($lim[1]) + 1, DAY_IN_SECONDS);\n        set_transient($lim[2], (int) get_transient($lim[2]) + 1, HOUR_IN_SECONDS);\n        self::write_cookie($uid, $new[\'code\']);\n        wp_send_json_success(array(\'code\' => $new[\'code\'], \'x\' => $new[\'x\'], \'now\' => time()));\n    }\n\n    /* ---------------------------------------------------------------- cleanup */\n\n    /** Deletes expired, never-used copies a day after they ended; used copies are kept as history but lose the marker. */\n    public static function cleanup() {\n        global $wpdb;\n        $before = time() - DAY_IN_SECONDS;\n        // phpcs:ignore WordPress.DB.DirectDatabaseQuery -- own marker meta, values prepared.\n        $ids = (array) $wpdb->get_col($wpdb->prepare(\n            "SELECT p.ID FROM {$wpdb->posts} p\n             INNER JOIN {$wpdb->postmeta} m ON m.post_id = p.ID AND m.meta_key = %s\n             INNER JOIN {$wpdb->postmeta} e ON e.post_id = p.ID AND e.meta_key = \'date_expires\'\n             WHERE p.post_type = \'shop_coupon\' AND e.meta_value <> \'\' AND CAST(e.meta_value AS UNSIGNED) < %d LIMIT 200",\n            self::META,\n            $before\n        ));\n        foreach ($ids as $id) {\n            $id = (int) $id;\n            try {\n                $cp = new WC_Coupon($id);\n                if ((int) $cp->get_usage_count() > 0) {\n                    delete_post_meta($id, self::META);\n                } else {\n                    wp_delete_post($id, true);\n                }\n            } catch (Throwable $e) {\n                unset($e);\n            }\n        }\n    }\n}\n'))

