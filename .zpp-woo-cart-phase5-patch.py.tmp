# =====================================================================================================
FILES.append(('pro', 'assets/js/front/front-woo-cart.js', 'ZPP_WC_P5', [
(r"""        shipBars($w, c, r);
    }

    /* ------------------------------------------------------------ cart state */""", r"""        shipBars($w, c, r);
        upImage($w, c, r);
    }
    /* ZPP_WC_P5: an Image layer with the custom class "zpp-upsell-image" shows the upsell product's photo. */
    function upImage($w, c, r) {
        var u = (r && r.u) ? upOf(c, r) : null;
        if (!u || !u.img || !/^(https?:)?\/\/|^\//i.test(String(u.img))) { return; }
        $w.find('.zpp-upsell-image img').each(function () {
            if (this.getAttribute('src') !== u.img) {
                this.removeAttribute('srcset');
                this.setAttribute('src', u.img);
            }
            if (u.name) { this.setAttribute('alt', String(u.name)); }
        });
    }

    /* ------------------------------------------------------------ cart state */"""),
]))

