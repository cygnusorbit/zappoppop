(r"""    /** The one product this popup offers right now""", r"""    /** Product photo for the upsell (ZPP_WC_P5): shown by an Image layer with the custom class zpp-upsell-image. */
    protected static function product_image($p) {
        $id  = (int) $p->get_image_id();
        $url = $id ? wp_get_attachment_image_url($id, 'woocommerce_single') : '';
        if (!$url && function_exists('wc_placeholder_img_src')) {
            $url = wc_placeholder_img_src('woocommerce_single');
        }
        return $url ? esc_url_raw((string) $url) : '';
    }

    /** The one product this popup offers right now"""),

