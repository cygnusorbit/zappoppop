import os, sys, shutil, subprocess

CORE = os.getcwd()
PRO = os.path.normpath(os.path.join(CORE, '..', 'zappoppop-pro'))
BK = os.path.join(CORE, '.patch-backups')
ROOTS = {'core': CORE, 'pro': PRO}

if not os.path.isfile(os.path.join(CORE, 'zappoppop.php')) or not os.path.isfile(os.path.join(PRO, 'zappoppop-pro.php')):
    sys.exit('ABORT: run from ~/Desktop/zappoppop with ../zappoppop-pro next to it.')

FILES = []   # (root, rel, marker, [(old, new), ...])

NEW = []     # (root, rel, marker, content)
NEW.append(('pro', 'includes/modules/class-zappoppop-woo-reminders.php', 'ZPP_WC_P5', '<?php\nif (!defined(\'ABSPATH\')) {\n    exit;\n}\n\n/**\n * ZapPopPop > Cart reminders (Pro): the abandoned-cart emails at a glance. ZPP_WC_P5\n * Totals, a status filter, one table with "Send now" and "Delete" per reminder. Reads the table that\n * ZapPopPop_Woo_Recover owns; every action is a POST with a nonce and needs the manage_options capability.\n * Same page shell, theme variables and Pro licence gate as the Statistics page.\n */\nclass ZapPopPop_Woo_Reminders {\n\n    const PAGE = \'zappoppop-cart-reminders\';\n    const PER  = 20;\n\n    protected static $hook = \'\';\n\n    public static function boot() {\n        add_action(\'zappoppop_admin_menu\', array(__CLASS__, \'menu\'));\n        add_action(\'admin_enqueue_scripts\', array(__CLASS__, \'assets\'));\n        add_action(\'admin_post_zappoppop_wcr\', array(__CLASS__, \'act\'));\n        add_filter(\'zappoppop_bar_links\', array(__CLASS__, \'bar_links\'));\n    }\n\n    protected static function available() {\n        return class_exists(\'ZapPopPop_Woo_Cart\') && ZapPopPop_Woo_Cart::woo_active() && ZapPopPop_Woo_Cart::module_active();\n    }\n\n    public static function menu($parent) {\n        if (!self::available()) {\n            return;\n        }\n        self::$hook = add_submenu_page(\n            $parent,\n            __(\'Cart reminders\', \'zappoppop\'),\n            __(\'Cart reminders\', \'zappoppop\'),\n            \'manage_options\',\n            self::PAGE,\n            array(__CLASS__, \'render\'),\n            7\n        );\n    }\n\n    public static function bar_links($links) {\n        if (!self::available()) {\n            return $links;\n        }\n        return ZapPopPop_Pro_Gate::insert_link($links, \'zappoppop-stats\', array(self::PAGE, __(\'Cart reminders\', \'zappoppop\'), \'dashicons-email-alt\'));\n    }\n\n    public static function assets($hook) {\n        if (self::$hook === \'\' || $hook !== self::$hook) {\n            return;\n        }\n        if (!ZapPopPop_Pro_Gate::unlocked()) {\n            ZapPopPop_Pro_Admin::enqueue_shell();\n            return;\n        }\n        wp_enqueue_style(\'dashicons\');\n        wp_enqueue_style(\'zappoppop-overview-css\', ZAPPOPPOP_URL . \'admin/css/overview.css\', array(), ZAPPOPPOP_VERSION);\n        wp_enqueue_script(\'zappoppop-overview-js\', ZAPPOPPOP_URL . \'admin/js/overview.js\', array(\'jquery\'), ZAPPOPPOP_VERSION, true);\n        $deps = array(\'zappoppop-overview-css\');\n        if (wp_style_is(\'zappoppop-theme-global-css\', \'enqueued\') || wp_style_is(\'zappoppop-theme-global-css\', \'registered\')) {\n            $deps[] = \'zappoppop-theme-global-css\';\n        }\n        wp_enqueue_style(\'zappoppop-woo-reminders-css\', ZAPPOPPOP_PRO_URL . \'assets/css/woo-reminders.css\', $deps, ZAPPOPPOP_PRO_VERSION);\n    }\n\n    /* ---------------------------------------------------------------- data */\n\n    /** Filter tabs: key => array(label, statuses or null for all). */\n    public static function groups() {\n        return array(\n            \'all\'       => array(__(\'All\', \'zappoppop\'), null),\n            \'waiting\'   => array(__(\'Waiting\', \'zappoppop\'), array(\'pending\', \'await\', \'sending\')),\n            \'sent\'      => array(__(\'Sent\', \'zappoppop\'), array(\'sent\')),\n            \'restored\'  => array(__(\'Came back\', \'zappoppop\'), array(\'restored\')),\n            \'recovered\' => array(__(\'Ordered on their own\', \'zappoppop\'), array(\'recovered\')),\n            \'unsub\'     => array(__(\'Unsubscribed\', \'zappoppop\'), array(\'unsub\')),\n            \'other\'     => array(__(\'Cancelled or failed\', \'zappoppop\'), array(\'cancelled\', \'failed\')),\n        );\n    }\n\n    /** @return array{waiting:int,emails:int,restored:int,recovered:int,unsub:int} */\n    public static function totals() {\n        global $wpdb;\n        $t   = ZapPopPop_Woo_Recover::table();\n        $out = array(\'waiting\' => 0, \'emails\' => 0, \'restored\' => 0, \'recovered\' => 0, \'unsub\' => 0);\n        // phpcs:ignore WordPress.DB.PreparedSQL.InterpolatedNotPrepared, WordPress.DB.DirectDatabaseQuery -- own table, no input.\n        foreach ((array) $wpdb->get_results("SELECT status, COUNT(*) AS n FROM {$t} GROUP BY status") as $r) {\n            $n = (int) $r->n;\n            if (in_array($r->status, array(\'pending\', \'await\', \'sending\'), true)) {\n                $out[\'waiting\'] += $n;\n            } elseif ($r->status === \'restored\') {\n                $out[\'restored\'] += $n;\n            } elseif ($r->status === \'recovered\') {\n                $out[\'recovered\'] += $n;\n            } elseif ($r->status === \'unsub\') {\n                $out[\'unsub\'] += $n;\n            }\n        }\n        // phpcs:ignore WordPress.DB.PreparedSQL.InterpolatedNotPrepared, WordPress.DB.DirectDatabaseQuery -- own table, no input.\n        $out[\'emails\'] = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$t} WHERE sent_at > 0");\n        return $out;\n    }\n\n    /** One page of reminders for a filter key. @return array{rows:array,total:int} */\n    public static function page($group, $paged) {\n        global $wpdb;\n        $t      = ZapPopPop_Woo_Recover::table();\n        $items  = $wpdb->prefix . \'zappoppop_items\';\n        $groups = self::groups();\n        $group  = isset($groups[$group]) ? $group : \'all\';\n        $sts    = $groups[$group][1];\n        $where  = \'\';\n        $args   = array();\n        if ($sts) {\n            $where = \' WHERE r.status IN (\' . implode(\',\', array_fill(0, count($sts), \'%s\')) . \')\';\n            $args  = $sts;\n        }\n        $off = max(0, ((int) $paged - 1)) * self::PER;\n        // phpcs:disable WordPress.DB.PreparedSQL.InterpolatedNotPrepared, WordPress.DB.DirectDatabaseQuery -- own tables; every value is prepared, $where only holds placeholders.\n        $count_sql = "SELECT COUNT(*) FROM {$t} r{$where}";\n        $total     = (int) $wpdb->get_var($args ? $wpdb->prepare($count_sql, $args) : $count_sql);\n        $rows      = $wpdb->get_results($wpdb->prepare(\n            "SELECT r.*, i.title AS popup_title FROM {$t} r LEFT JOIN {$items} i ON i.uid = r.popup_uid{$where} ORDER BY r.id DESC LIMIT %d OFFSET %d",\n            array_merge($args, array(self::PER, $off))\n        ));\n        // phpcs:enable\n        return array(\'rows\' => (array) $rows, \'total\' => $total);\n    }\n\n    public static function status_label($row) {\n        $step2 = isset($row->step) && (int) $row->step === 2;\n        switch ($row->status) {\n            case \'pending\':\n                return $step2 ? __(\'Follow-up waiting\', \'zappoppop\') : __(\'Waiting\', \'zappoppop\');\n            case \'await\':\n                return __(\'Awaiting email confirmation\', \'zappoppop\');\n            case \'sending\':\n                return __(\'Sending\', \'zappoppop\');\n            case \'sent\':\n                return $step2 ? __(\'Follow-up sent\', \'zappoppop\') : __(\'Sent\', \'zappoppop\');\n            case \'restored\':\n                return __(\'Came back\', \'zappoppop\');\n            case \'recovered\':\n                return __(\'Ordered on their own\', \'zappoppop\');\n            case \'cancelled\':\n                return __(\'Cancelled\', \'zappoppop\');\n            case \'failed\':\n                return __(\'Failed\', \'zappoppop\');\n            case \'unsub\':\n                return __(\'Unsubscribed\', \'zappoppop\');\n        }\n        return (string) $row->status;\n    }\n\n    /* ---------------------------------------------------------------- actions */\n\n    public static function act() {\n        if (!current_user_can(\'manage_options\')) {\n            wp_die(esc_html__(\'You do not have sufficient permissions to access this page.\', \'zappoppop\'));\n        }\n        // phpcs:disable WordPress.Security.NonceVerification.Missing -- verified right below with check_admin_referer().\n        $id = isset($_POST[\'id\']) ? absint($_POST[\'id\']) : 0;\n        $op = isset($_POST[\'op\']) ? sanitize_key(wp_unslash($_POST[\'op\'])) : \'\';\n        $st = isset($_POST[\'status\']) ? sanitize_key(wp_unslash($_POST[\'status\'])) : \'all\';\n        $pg = isset($_POST[\'paged\']) ? max(1, absint($_POST[\'paged\'])) : 1;\n        // phpcs:enable\n        check_admin_referer(\'zappoppop_wcr_\' . $id);\n        global $wpdb;\n        $t    = ZapPopPop_Woo_Recover::table();\n        $done = \'none\';\n        if ($id > 0 && $op === \'send\') {\n            // phpcs:ignore WordPress.DB.PreparedSQL.InterpolatedNotPrepared, WordPress.DB.DirectDatabaseQuery -- own table, values prepared.\n            $n = (int) $wpdb->query($wpdb->prepare("UPDATE {$t} SET send_at = %d WHERE id = %d AND status = \'pending\'", time(), $id));\n            if ($n > 0) {\n                ZapPopPop_Woo_Recover::tick();\n                $done = \'send\';\n            }\n        } elseif ($id > 0 && $op === \'delete\') {\n            /* An unsubscribe record is never deleted here: it is what keeps the address from being emailed again. */\n            // phpcs:ignore WordPress.DB.PreparedSQL.InterpolatedNotPrepared, WordPress.DB.DirectDatabaseQuery -- own table, value prepared.\n            $n = (int) $wpdb->query($wpdb->prepare("DELETE FROM {$t} WHERE id = %d AND status <> \'unsub\'", $id));\n            if ($n > 0) {\n                $done = \'delete\';\n            }\n        }\n        wp_safe_redirect(add_query_arg(array(\'page\' => self::PAGE, \'status\' => $st, \'paged\' => $pg, \'done\' => $done), admin_url(\'admin.php\')));\n        exit;\n    }\n\n    /* ---------------------------------------------------------------- page */\n\n    public static function render() {\n        if (!current_user_can(\'manage_options\')) {\n            wp_die(esc_html__(\'You do not have sufficient permissions to access this page.\', \'zappoppop\'));\n        }\n        if (!ZapPopPop_Pro_Gate::unlocked()) {\n            ZapPopPop_Pro_Gate::locked_screen(\n                __(\'Cart reminders\', \'zappoppop\'),\n                \'dashicons-email-alt\',\n                __(\'See every abandoned-cart reminder: who is waiting, who got an email and who came back. Activate your ZapPopPop Pro licence to open this screen.\', \'zappoppop\')\n            );\n            return;\n        }\n        // phpcs:disable WordPress.Security.NonceVerification.Recommended -- read-only filters of a list.\n        $group = isset($_GET[\'status\']) ? sanitize_key(wp_unslash($_GET[\'status\'])) : \'all\';\n        $paged = isset($_GET[\'paged\']) ? max(1, absint($_GET[\'paged\'])) : 1;\n        $done  = isset($_GET[\'done\']) ? sanitize_key(wp_unslash($_GET[\'done\'])) : \'\';\n        // phpcs:enable\n        $groups = self::groups();\n        if (!isset($groups[$group])) {\n            $group = \'all\';\n        }\n        $tot  = self::totals();\n        $data = self::page($group, $paged);\n        $pages = max(1, (int) ceil($data[\'total\'] / self::PER));\n        $base  = admin_url(\'admin.php\');\n        $fmt   = get_option(\'date_format\') . \' \' . get_option(\'time_format\');\n        $bar_title   = __(\'Cart reminders\', \'zappoppop\');\n        $bar_icon    = \'dashicons-email-alt\';\n        $bar_actions = \'\';\n        $notices = array(\n            \'send\'   => __(\'The reminder was sent.\', \'zappoppop\'),\n            \'delete\' => __(\'The reminder was deleted.\', \'zappoppop\'),\n            \'none\'   => __(\'Nothing was changed: that reminder is no longer in this state.\', \'zappoppop\'),\n        );\n        ?>\n        <div class="wrap zpp-wcr-wrap">\n            <h1 class="screen-reader-text"><?php esc_html_e(\'Cart reminders\', \'zappoppop\'); ?></h1>\n            <div class="zappoppop-dash" style="margin:0 0 20px;max-width:none;">\n                <?php include ZAPPOPPOP_PATH . \'templates/partials/dash-bar.php\'; ?>\n            </div>\n\n            <?php if ($done !== \'\' && isset($notices[$done])) : ?>\n                <div class="zpp-wcr-note <?php echo $done === \'none\' ? \'is-warn\' : \'is-ok\'; ?>"><?php echo esc_html($notices[$done]); ?></div>\n            <?php endif; ?>\n\n            <div class="zpp-wcr-kpis">\n                <div><span><?php echo (int) $tot[\'waiting\']; ?></span><em><?php esc_html_e(\'Waiting to be sent\', \'zappoppop\'); ?></em></div>\n                <div><span><?php echo (int) $tot[\'emails\']; ?></span><em><?php esc_html_e(\'Emails sent\', \'zappoppop\'); ?></em></div>\n                <div><span><?php echo (int) $tot[\'restored\']; ?></span><em><?php esc_html_e(\'Came back to the cart\', \'zappoppop\'); ?></em></div>\n                <div><span><?php echo (int) $tot[\'recovered\']; ?></span><em><?php esc_html_e(\'Ordered on their own\', \'zappoppop\'); ?></em></div>\n                <div><span><?php echo (int) $tot[\'unsub\']; ?></span><em><?php esc_html_e(\'Unsubscribed\', \'zappoppop\'); ?></em></div>\n            </div>\n\n            <div class="zpp-wcr-card">\n                <ul class="zpp-wcr-tabs">\n                    <?php foreach ($groups as $key => $g) : ?>\n                        <li><a class="<?php echo $key === $group ? \'is-on\' : \'\'; ?>" href="<?php echo esc_url(add_query_arg(array(\'page\' => self::PAGE, \'status\' => $key), $base)); ?>"><?php echo esc_html($g[0]); ?></a></li>\n                    <?php endforeach; ?>\n                </ul>\n\n                <?php if (!$data[\'rows\']) : ?>\n                    <p class="zpp-wcr-empty"><?php esc_html_e(\'No reminders here yet. They appear when a visitor submits a popup form with the cart reminder consent box ticked.\', \'zappoppop\'); ?></p>\n                <?php else : ?>\n                    <table class="zpp-wcr-table">\n                        <thead>\n                            <tr>\n                                <th><?php esc_html_e(\'Email\', \'zappoppop\'); ?></th>\n                                <th><?php esc_html_e(\'Popup\', \'zappoppop\'); ?></th>\n                                <th><?php esc_html_e(\'Status\', \'zappoppop\'); ?></th>\n                                <th><?php esc_html_e(\'Saved\', \'zappoppop\'); ?></th>\n                                <th><?php esc_html_e(\'Next / last email\', \'zappoppop\'); ?></th>\n                                <th class="zpp-wcr-act"><?php esc_html_e(\'Actions\', \'zappoppop\'); ?></th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                        <?php foreach ($data[\'rows\'] as $r) : ?>\n                            <?php\n                            $id    = (int) $r->id;\n                            $title = (isset($r->popup_title) && $r->popup_title !== null && $r->popup_title !== \'\') ? (string) $r->popup_title : (string) $r->popup_uid;\n                            if ($r->status === \'pending\') {\n                                /* translators: %s: date and time */\n                                $when = sprintf(__(\'Sends %s\', \'zappoppop\'), wp_date($fmt, (int) $r->send_at));\n                            } elseif ((int) $r->sent_at > 0) {\n                                $when = wp_date($fmt, (int) $r->sent_at);\n                            } else {\n                                $when = \'-\';\n                            }\n                            ?>\n                            <tr>\n                                <td><?php echo esc_html((string) $r->email); ?></td>\n                                <td><?php echo esc_html($title); ?></td>\n                                <td><span class="zpp-wcr-badge is-<?php echo esc_attr((string) $r->status); ?>"><?php echo esc_html(self::status_label($r)); ?></span></td>\n                                <td><?php echo esc_html(wp_date($fmt, (int) $r->created)); ?></td>\n                                <td><?php echo esc_html($when); ?></td>\n                                <td class="zpp-wcr-act">\n                                    <?php if ($r->status === \'pending\') : ?>\n                                        <?php self::action_form($id, \'send\', __(\'Send now\', \'zappoppop\'), $group, $paged, false); ?>\n                                    <?php endif; ?>\n                                    <?php if ($r->status !== \'unsub\') : ?>\n                                        <?php self::action_form($id, \'delete\', __(\'Delete\', \'zappoppop\'), $group, $paged, true); ?>\n                                    <?php else : ?>\n                                        <span class="zpp-wcr-kept" title="<?php esc_attr_e(\'Kept so this address is never emailed again.\', \'zappoppop\'); ?>"><?php esc_html_e(\'Kept\', \'zappoppop\'); ?></span>\n                                    <?php endif; ?>\n                                </td>\n                            </tr>\n                        <?php endforeach; ?>\n                        </tbody>\n                    </table>\n                    <?php if ($pages > 1) : ?>\n                        <div class="zpp-wcr-pages">\n                            <?php\n                            echo wp_kses_post(paginate_links(array(\n                                \'base\'    => add_query_arg(array(\'page\' => self::PAGE, \'status\' => $group, \'paged\' => \'%#%\'), $base),\n                                \'format\'  => \'\',\n                                \'current\' => $paged,\n                                \'total\'   => $pages,\n                            )));\n                            ?>\n                        </div>\n                    <?php endif; ?>\n                <?php endif; ?>\n            </div>\n            <p class="zpp-wcr-foot"><?php esc_html_e(\'Reminders are sent by WordPress cron when your site gets visits, using wp_mail(). Unsubscribed addresses stay on a do-not-email list.\', \'zappoppop\'); ?></p>\n        </div>\n        <?php\n    }\n\n    protected static function action_form($id, $op, $label, $group, $paged, $confirm) {\n        ?>\n        <form method="post" action="<?php echo esc_url(admin_url(\'admin-post.php\')); ?>" class="zpp-wcr-inline"<?php echo $confirm ? \' onsubmit="return window.confirm(\' . esc_attr(wp_json_encode(__(\'Delete this reminder?\', \'zappoppop\'))) . \');"\' : \'\'; ?>>\n            <input type="hidden" name="action" value="zappoppop_wcr" />\n            <input type="hidden" name="op" value="<?php echo esc_attr($op); ?>" />\n            <input type="hidden" name="id" value="<?php echo (int) $id; ?>" />\n            <input type="hidden" name="status" value="<?php echo esc_attr($group); ?>" />\n            <input type="hidden" name="paged" value="<?php echo (int) $paged; ?>" />\n            <?php wp_nonce_field(\'zappoppop_wcr_\' . (int) $id); ?>\n            <button type="submit" class="button button-small"><?php echo esc_html($label); ?></button>\n        </form>\n        <?php\n    }\n}\n'))
NEW.append(('pro', 'assets/css/woo-reminders.css', 'ZPP_WC_P5', '/* Cart reminders page (Pro). ZPP_WC_P5. Same shell and theme variables as the Statistics page; follows the Theme on/off switch. */\nbody.wp-admin #wpcontent .zpp-wcr-wrap {\n    box-sizing: border-box; width: auto; max-width: none; margin: 10px 20px 0 2px; padding: 0 10px 40px 0;\n}\nbody.wp-admin #wpcontent .zpp-wcr-wrap .zappoppop-dash-bar { box-sizing: border-box; max-width: 100%; }\n.zpp-wcr-wrap .zappoppop-dash-bar { position: -webkit-sticky; position: sticky; top: 32px; z-index: 30; }\n.zpp-wcr-wrap { font-family: var(--zpp-font-base, inherit); color: var(--zpp-c-text, #1d2327); }\n\n.zpp-wcr-kpis { display: -ms-grid; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; margin: 0 0 20px; }\n.zpp-wcr-kpis > div,\n.zpp-wcr-card {\n    background: var(--zpp-c-bg-card, #fff);\n    border: var(--zpp-bw, 1px) solid var(--zpp-c-border, #dcdcde);\n    border-radius: var(--zpp-r-card, 8px);\n    box-shadow: var(--zpp-shadow-card, 0 1px 3px rgba(0, 0, 0, .05));\n}\n.zpp-wcr-kpis > div { padding: 16px 18px; }\n.zpp-wcr-kpis span { display: block; font-size: 28px; line-height: 1.1; font-weight: 700; color: var(--zpp-c-heading, #1d2327); font-family: var(--zpp-font-heading, inherit); }\n.zpp-wcr-kpis em { display: block; margin-top: 4px; font-style: normal; font-size: 12px; color: var(--zpp-c-muted, #787c82); }\n\n.zpp-wcr-card { padding: 6px 0 12px; overflow-x: auto; }\n.zpp-wcr-tabs { display: -webkit-box; display: flex; flex-wrap: wrap; gap: 4px; margin: 0; padding: 10px 14px 12px; list-style: none; border-bottom: 1px solid var(--zpp-c-border, #dcdcde); }\n.zpp-wcr-tabs li { margin: 0; }\n.zpp-wcr-tabs a { display: block; padding: 5px 12px; border-radius: 14px; font-size: 12px; font-weight: 600; text-decoration: none; color: var(--zpp-c-text, #334155); background: var(--zpp-c-row-hover, #f1f5f9); }\n.zpp-wcr-tabs a:hover { color: var(--zpp-c-link-hover, #135e96); }\n.zpp-wcr-tabs a.is-on { background: var(--zpp-c-link, #2271b1); color: #fff; }\n\n.zpp-wcr-table { width: 100%; border-collapse: collapse; }\n.zpp-wcr-table th, .zpp-wcr-table td { padding: 10px 14px; text-align: left; vertical-align: middle; border-bottom: 1px solid var(--zpp-c-border, #eef0f2); font-size: 13px; }\n.zpp-wcr-table th { font-size: 11px; text-transform: uppercase; letter-spacing: .3px; color: var(--zpp-c-muted, #787c82); font-weight: 700; }\n.zpp-wcr-table tbody tr:hover td { background: var(--zpp-c-row-hover, #f8fafc); }\n.zpp-wcr-act { text-align: right !important; white-space: nowrap; }\n.zpp-wcr-inline { display: inline-block; margin: 0 0 0 6px; }\n.zpp-wcr-kept { font-size: 12px; color: var(--zpp-c-muted, #787c82); cursor: help; }\n\n.zpp-wcr-badge { display: -webkit-inline-box; display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 700; line-height: 18px; background: #e5e7eb; color: #374151; }\n.zpp-wcr-badge.is-pending, .zpp-wcr-badge.is-await, .zpp-wcr-badge.is-sending { background: #fef3c7; color: #92400e; }\n.zpp-wcr-badge.is-sent { background: #dbeafe; color: #1e40af; }\n.zpp-wcr-badge.is-restored { background: #dcfce7; color: #166534; }\n.zpp-wcr-badge.is-recovered { background: #e0e7ff; color: #3730a3; }\n.zpp-wcr-badge.is-unsub, .zpp-wcr-badge.is-failed { background: #fee2e2; color: #991b1b; }\n\n.zpp-wcr-empty { margin: 0; padding: 26px 20px; color: var(--zpp-c-muted, #787c82); }\n.zpp-wcr-pages { padding: 12px 14px 0; }\n.zpp-wcr-pages .page-numbers { display: inline-block; padding: 3px 9px; margin-right: 3px; border-radius: 4px; text-decoration: none; border: 1px solid var(--zpp-c-border, #dcdcde); }\n.zpp-wcr-pages .page-numbers.current { background: var(--zpp-c-link, #2271b1); border-color: var(--zpp-c-link, #2271b1); color: #fff; }\n.zpp-wcr-foot { margin: 12px 2px 0; font-size: 12px; color: var(--zpp-c-muted, #787c82); }\n.zpp-wcr-note { margin: 0 0 16px; padding: 10px 14px; border-radius: var(--zpp-r-card, 8px); font-size: 13px; font-weight: 600; }\n.zpp-wcr-note.is-ok { background: #dcfce7; color: #166534; }\n.zpp-wcr-note.is-warn { background: #fef3c7; color: #92400e; }\nbody.zappoppop-admin-themed .zpp-wcr-wrap .button { border-radius: var(--zpp-r-button, 3px); }\n'))

# =====================================================================================================
# 2. Recover class: follow-up email (step 2), restore rules, boots the reminders screen
# =====================================================================================================
FILES.append(('pro', 'includes/modules/class-zappoppop-woo-recover.php', 'ZPP_WC_P5', [

(r"""    const VER   = '1';""", r"""    const VER   = '2'; /* ZPP_WC_P5: adds the "step" column */"""),

(r"""            'rc_coupon'  => '',
        );""", r"""            'rc_coupon'  => '',
            'rc2_on'      => false,
